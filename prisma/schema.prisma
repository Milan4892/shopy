generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String             @unique
  referralCode       String?             @unique
  referredById       String?
  status             UserStatus          @default(ACTIVE)
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  twoFactorEnabled   Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lastLoginAt        DateTime?
  auditLogs          AuditLog[]
  sessions           Session[]
  ownedProducts      UserProduct[]
  roles              UserRole[]
  verifications      VerificationToken[]
  wallet             Wallet?
  walletTransactions WalletTransaction[]
  miningRecords      MiningRecord[]
  bankAccounts       BankAccount[]
  withdrawals        Withdrawal[]
  missionCompletions MissionCompletion[]
  luckyDraws LuckyDraw[]
  notifications Notification[]
  emailNotifications       Boolean @default(true)
transactionNotifications Boolean @default(true)
miningNotifications      Boolean @default(true)
marketingNotifications   Boolean @default(false)
twoFactorSecret String?

  referredBy          User?   @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers       User[]  @relation("UserReferrals")
  referralsMade       Referral[] @relation("ReferrerReferrals")
  referralReceived    Referral?  @relation("ReferredUserReferral")

  @@index([status])
  @@index([createdAt])
  @@index([emailVerifiedAt])
  @@index([referredById])
}

model Role {
  id          String           @id @default(uuid())
  code        RoleCode         @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Session {
  id           String        @id @default(uuid())
  userId       String
  tokenHash    String        @unique
  status       SessionStatus @default(ACTIVE)
  ipAddress    String?
  userAgent    String?
  deviceName   String?
  expiresAt    DateTime
  lastActiveAt DateTime      @default(now())
  createdAt    DateTime      @default(now())
  revokedAt    DateTime?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model VerificationToken {
  id        String           @id @default(uuid())
  userId    String?
  type      VerificationType
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
}

model AuditLog {
  id          String      @id @default(uuid())
  userId      String?
  action      AuditAction
  description String
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Product {
  id                String        @id @default(uuid())
  sku               String        @unique
  name              String
  description       String?
  price             Decimal
  speed             Int
  batteryRange      Int
  stock             Int           @default(0)
  imageUrl          String?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  miningLimitPerDay Int           @default(2)
  miningReward      Decimal
  userProducts      UserProduct[]

  @@index([price])
  @@index([isActive])
}

model UserProduct {
  id            String          @id @default(uuid())
  userId        String
  productId     String
  purchasePrice Decimal
  status        OwnershipStatus @default(ACTIVE)
  acquiredAt    DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  product       Product         @relation(fields: [productId], references: [id])
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  miningRecords MiningRecord[]

  @@index([userId])
  @@index([productId])
  @@index([status])
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  balance      Decimal             @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  withdrawals  Withdrawal[]

  @@index([userId])
}

model WalletTransaction {
  id                   String   @id @default(uuid())
  userId               String
  walletId             String
  reference            String   @unique
  gateway              String   @default("PAYSTACK")
  gatewayTransactionId BigInt?
  type                 String
  status               String
  amount               Decimal
  currency             String   @default("NGN")
  description          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model MiningRecord {
  id            String   @id @default(uuid())
  userId        String
  userProductId String
  amount        Decimal
  minedAt       DateTime @default(now())
  dateKey       String

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userProduct UserProduct @relation(fields: [userProductId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userProductId])
  @@index([dateKey])
  @@index([userId, dateKey])
}

model BankAccount {
  id            String       @id @default(uuid())
  userId        String
  bankName      String
  accountNumber String
  accountName   String
  isVerified    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  withdrawals   Withdrawal[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountNumber])
  @@index([userId])
}

model Withdrawal {
  id            String    @id @default(uuid())
  userId        String
  walletId      String
  bankAccountId String
  amount        Decimal
  fee           Decimal   @default(0)
  payoutAmount  Decimal
  status        String    @default("PENDING")
  reference     String    @unique
  note          String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet      Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
  @@index([bankAccountId])
  @@index([status])
  @@index([createdAt])
}

model Mission {
  id          String   @id @default(uuid())
  title       String
  description String?
  reward      Decimal
  target      Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  completions MissionCompletion[]
}

model MissionCompletion {
  id          String    @id @default(uuid())
  missionId   String
  userId      String
  progress    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([missionId, userId])
  @@index([userId])
  @@index([missionId])
}

model Referral {
  id             String   @id @default(uuid())
  referrerId     String
  referredUserId String   @unique
  createdAt      DateTime @default(now())

  referrer     User @relation("ReferrerReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User @relation("ReferredUserReferral", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([createdAt])
}

model LuckyDraw {
  id          String   @id @default(uuid())
  userId      String
  rewardType  String
  rewardValue Decimal?
  spunAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum OwnershipStatus {
  ACTIVE
  INACTIVE
  SOLD
}

enum RoleCode {
  SUPER_ADMIN
  ADMIN
  FINANCE_ADMIN
  CRYPTO_ADMIN
  SUPPORT_ADMIN
  CONTENT_ADMIN
  MODERATOR
  CUSTOMER
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_OTP
  TWO_FACTOR
  PHONE_VERIFICATION
}

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGED
  EMAIL_VERIFIED
  OTP_REQUESTED
  OTP_VERIFIED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  SESSION_REVOKED
  PROFILE_UPDATED
  ROLE_ASSIGNED
  ROLE_REMOVED
  USER_SUSPENDED
  USER_DEACTIVATED
  ADMIN_ACTION
}
